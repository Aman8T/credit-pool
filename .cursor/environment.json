{
  "name": "Credit Pool",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "user": "node",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "dev-server",
      "command": "corepack pnpm dev --hostname 0.0.0.0 --port 3000"
    }
  ],
  "ports": [
    {
      "name": "web",
      "port": 3000
    }
  ]
}
